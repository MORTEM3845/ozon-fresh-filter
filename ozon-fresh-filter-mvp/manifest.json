{
  "manifest_version": 3,
  "name": "Ozon Fresh Filter MVP",
  "version": "0.2.1",
  "description": "Быстро собирает товары из каталога Ozon и фильтрует по цене, скидке и словам.",
  "permissions": [
    "storage",
    "sidePanel",
    "tabs"
  ],
  "host_permissions": [
    "https://www.ozon.ru/*"
  ],
  "action": {
    "default_title": "Открыть Ozon Fresh Filter"
  },
  "background": {
    "service_worker": "service-worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.ozon.ru/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "side_panel": {
    "default_path": "sidepanel.html"
  }
}